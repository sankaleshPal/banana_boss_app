{
  "expo": {
    "name": "Banana Boss",
    "slug": "banana-boss-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDE046"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bananaboss.native"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDE047"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bananaboss.native"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Banana Boss",
      "shortName": "BananaBoss",
      "description": "Reports & Billing for restaurant managers",
      "themeColor": "#FDE047",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
